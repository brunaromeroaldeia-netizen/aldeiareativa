# Copie para .env e ajuste. NUNCA versione o arquivo .env.
NODE_ENV=production
PORT=3000
# URL pública do sistema (usada nos links de convite e de redefinição de senha)
APP_URL=https://reativa.seudominio.com.br
DATABASE_URL=postgres://aldeia:TROQUE_ESTA_SENHA@localhost:5432/aldeia_reativa
DATABASE_SSL=false
# Usado pelo docker-compose
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
APP_TIMEZONE=America/Sao_Paulo
MAX_UPLOAD_MB=20
SESSION_DAYS=7
SESSION_IDLE_HOURS=12

# E-mails (logins) das usuárias iniciais — usados apenas por "npm run setup"
ADMIN_NAME=Administradora
ADMIN_EMAIL=
LETICIA_EMAIL=
GIOVANA_EMAIL=

# Opcional: SMTP para "Esqueci minha senha" enviar o link por e-mail.
# Sem SMTP, o pedido aparece para a administradora, que gera um link seguro.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aldeia Reativa <no-reply@seudominio.com.br>"

# Backups (npm run backup)
BACKUP_DIR=./backups
BACKUP_KEEP=30
